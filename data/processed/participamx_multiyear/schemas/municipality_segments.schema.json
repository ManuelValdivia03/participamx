    "election_year": {
      "type": "integer",
      "enum": [
        2009,
        2012,
        2015,
        2018,
        2021,
        2024
      ]
    },
    "election_type": {
      "type": "string",
      "enum": [
        "presidential",
        "midterm"
      ]
    },
    "unit": {
