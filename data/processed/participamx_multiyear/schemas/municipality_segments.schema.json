            "minimum": 0
          },
          "SV": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "NV": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "NS": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "source_row_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sex_2_source_rows": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sex_2_nominal_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
