          "direction",
          "near_reference",
          "sufficient_support",
          "low_ln",
          "low_specified",
          "few_source_rows",
          "high_ns",
          "section_count",
          "section_ln_share_U",
          "section_ln_share_R",
          "section_ln_share_M"
