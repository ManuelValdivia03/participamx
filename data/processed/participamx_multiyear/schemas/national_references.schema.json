{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParticipaMX · national_references",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "election_year": {
      "type": "integer",
      "enum": [
        2009,
        2012,
        2015,
        2018,
        2021,
        2024
      ]
    },
    "election_type": {
      "type": "string",
      "enum": [
        "presidential",
        "midterm"
      ]
    },
    "unit": {
      "const": "national_age_band_sex"
    },
    "source_id": {
      "const": "ine_counted_lists"
    },
    "rate_unit": {
      "const": "proportion"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "election_year": {
            "type": "integer",
            "enum": [
              2009,
              2012,
              2015,
              2018,
              2021,
              2024
            ],
            "minimum": 0
          },
          "age_band": {
            "type": "string",
            "enum": [
              "18-34",
              "35-59",
              "60-100",
              "101+"
            ]
          },
          "sex_code": {
            "type": "string",
            "enum": [
              "0",
              "1",
              "2"
            ]
          },
          "LN": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "SV": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "NV": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "NS": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "source_row_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sex_2_source_rows": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sex_2_nominal_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "national_specified_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "national_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "election_year",
          "age_band",
          "sex_code",
          "LN",
          "SV",
          "NV",
          "NS",
          "source_row_count",
          "sex_2_source_rows",
          "sex_2_nominal_count",
          "national_specified_count",
          "national_rate"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "election_year",
    "election_type",
    "unit",
    "source_id",
    "rate_unit",
    "data",
    "warnings"
  ],
  "additionalProperties": false
}